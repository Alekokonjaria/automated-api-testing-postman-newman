							"});\r",
							"\r",
							"const responseJson = pm.response.json();\r",
							"\r",
							"const bookStock = responseJson[\"current-stock\"];\r",
							"\r",
							"pm.test(\"CheckStock\", () => {\r",
							"    pm.expect(bookStock).to.be.above(0);\r",
							"})"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
